# ===== 数据库 =====
# 快速体验可用 SQLite（默认，无需安装数据库）：
DATABASE_URL=sqlite:///./smart_life.db
# 正式部署请改用 MySQL（先导入 database/schema.sql）：
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/smart_life

# ===== 安全 =====
# 生产环境必须替换为长随机字符串，且不得提交到代码仓库
JWT_SECRET=replace-this-with-a-long-random-secret
TOKEN_EXPIRE_DAYS=7
# 跨域来源，多个用英文逗号分隔；生产环境写明前端域名
CORS_ORIGINS=*

# ===== 大模型服务（OpenAI 兼容 chat/completions 接口）=====
# 示例（智谱）：AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  AI_MODEL=glm-4-flash
# 示例（通义）：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
# 每用户每日 AI 调用上限（成本控制）
AI_DAILY_LIMIT=30
